# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# The service connects as the least-privilege `app` user (DML only, no DDL).
# MySQL 8 auth (caching_sha2_password) needs TLS or RSA key retrieval. Key retrieval is fine on a
# private dev network; in production use TLS instead (?ssl=true) and drop allowPublicKeyRetrieval.
DATABASE_URL=mysql://app:app_dev_password@localhost:3307/weather?allowPublicKeyRetrieval=true
# Max connections in the pool per instance.
DB_POOL_SIZE=10

# Used only by docker-compose to bootstrap MySQL users (dev defaults).
MYSQL_HOST_PORT=3307
MYSQL_ROOT_PASSWORD=root_dev_password
APP_DB_PASSWORD=app_dev_password
MIGRATOR_DB_PASSWORD=migrator_dev_password

# Open-Meteo endpoints (defaults shown). Point these at the mock upstream for load tests.
# OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
# OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
UPSTREAM_TIMEOUT_MS=6000
UPSTREAM_MAX_RETRIES=1

# GraphQL query-shape limits.
GRAPHQL_MAX_DEPTH=6
GRAPHQL_MAX_ROOT_FIELDS=3

# Prisma CLI only (migrations run as the DDL-capable `migrator` user, never the app user).
MIGRATE_DATABASE_URL=mysql://migrator:migrator_dev_password@localhost:3307/weather
SHADOW_DATABASE_URL=mysql://migrator:migrator_dev_password@localhost:3307/weather_shadow

# Cache lifetimes.
FORECAST_FRESH_MINUTES=180
FORECAST_DEGRADED_FRESH_MINUTES=15
FORECAST_MAX_STALE_HOURS=24
GEOCODE_TTL_DAYS=30
GEOCODE_NEGATIVE_TTL_HOURS=24
